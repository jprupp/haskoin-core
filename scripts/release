#!/usr/bin/env bash

find() {
  local thing="$1"
  perl -lnE "say if s/^\\s*$thing:\\s*([^\\s]+)\\s*\$/\\1/" package.yaml
}

if [[ ! -f package.yaml ]]
then
  echo "No package.yaml present" >&2
  exit 1
fi

package="$(find name)"
ver="$(find version)"

if [[ -z $package || -z $ver ]]
then
  echo "No package or version found"
  exit 1
fi

echo "package: $package"
echo "ver: $ver"

git tag -m "Version $ver" "v$ver"
git push origin master
git push origin "v$ver"
stack upload .
stack haddock --haddock-for-hackage
stack upload . --documentation
